{
  "name": "design-kingdom-functions",
  "private": true,
  "engines": {
    "node": "20"
  },
  "type": "module",
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "test": "vitest run src",
    "serve": "npm run build && firebase emulators:start --only functions,firestore,auth",
    "deploy": "firebase deploy --only functions",
    "eval": "tsx src/review/eval_harness.ts",
    "test:integration": "FIRESTORE_EMULATOR_HOST=127.0.0.1:8080 vitest run test"
  },
  "dependencies": {
    "firebase-admin": "^12.1.0",
    "firebase-functions": "^5.0.1"
  },
  "devDependencies": {
    "typescript": "^5.4.5",
    "vitest": "^1.6.0",
    "glob": "^10.3.10",
    "yaml": "^2.4.1",
    "tsx": "^4.7.0",
    "firebase-functions-test": "^3.3.0"
  }
}
